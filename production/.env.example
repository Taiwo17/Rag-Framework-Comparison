# Application settings
APP_NAME=Springer Capital RAG API

# Used when you run the API directly, outside Docker Compose.
HOST=0.0.0.0
PORT=8000

# Ollama settings.
# Docker Compose overrides OLLAMA_BASE_URL with the host-accessible URL.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Embedding and retrieval settings.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Used when you run the API directly.
# Docker Compose overrides this path.
VECTOR_STORE_PATH=evaluation/vector_stores/langchain
TOP_K=4

# Required secrets.
# Generate separate secure values using: openssl rand -hex 32
API_KEY=replace-with-a-secure-api-key
REDIS_PASSWORD=replace-with-a-secure-redis-password